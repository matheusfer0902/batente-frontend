# ─────────────────────────────────────────────────────────────────────
# Origem da API de autenticação.
#
# Topologia cross-site: frontend e backend em domínios distintos. Por isso
# NÃO pode derivar de window.location — precisa ser explícito, e precisa
# constar em CORS_ALLOWED_ORIGINS no backend (a recíproca).
#
# O backend sobe na porta de PORT (.env do backend), hoje :3030. O front fica
# em :3000, que é o default do Next — não há colisão.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3030"

# ─────────────────────────────────────────────────────────────────────
# CUTOVER · qual transporte cada prefixo usa.
#
# `/auth` e `/users` são sempre reais, fora de qualquer lista.
#
# Dois mecanismos, nesta precedência:
#
# 1. NEXT_PUBLIC_API_MODE=real  — tudo real, menos o que estiver em
#    NEXT_PUBLIC_MOCK_PREFIXES. É uma lista de exceção: o default é ir ao
#    backend, e cada entrada aqui é uma dívida explícita.
#
# 2. NEXT_PUBLIC_REAL_API_PREFIXES — lista de inclusão, usada só quando
#    API_MODE não é "real". Aceita "all" ou prefixos separados por vírgula.
#
# Todos os domínios do painel já têm backend, então a lista de exceção está
# vazia. `/badges`, `/audit-logs`, `/gate` e `/settings` são somente-leitura no
# backend — as telas correspondentes também não escrevem, então o cutover não
# quebra nada. `/timekeeping` entrou por completo: `mirror`, `pending` e
# `adjustments` existem, e é o que os blocos do /inicio consomem.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_MOCK_PREFIXES=

# Alternativa ao modo acima — ignorada quando API_MODE=real:
# NEXT_PUBLIC_REAL_API_PREFIXES=all
