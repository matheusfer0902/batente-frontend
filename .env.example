# ─────────────────────────────────────────────────────────────────────
# Origem da API de autenticação.
#
# Topologia cross-site: frontend e backend em domínios distintos. Por isso
# NÃO pode derivar de window.location — precisa ser explícito, e precisa
# constar em CORS_ALLOWED_ORIGINS no backend (a recíproca).
#
# Em dev, o backend sobe em :3000, então rode o front em outra porta:
#   npm run dev -- -p 3001
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Modo real: todas as rotas de painel vão ao backend (recomendado com hardware).
NEXT_PUBLIC_API_MODE=real

# Cutover parcial — ignorado quando API_MODE=real. Use "all" ou lista separada por vírgula:
# NEXT_PUBLIC_REAL_API_PREFIXES=all
# NEXT_PUBLIC_REAL_API_PREFIXES="/access-events,/devices,/timekeeping,/absences"
