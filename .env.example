# ─────────────────────────────────────────────────────────────────────
# Origem da API de autenticação.
#
# Topologia cross-site: frontend e backend em domínios distintos. Por isso
# NÃO pode derivar de window.location — precisa ser explícito, e precisa
# constar em CORS_ALLOWED_ORIGINS no backend (a recíproca).
#
# Em dev, o backend sobe em :3000, então rode o front em outra porta:
#   npm run dev -- -p 3001
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────
# CUTOVER · prefixos que vão ao backend real (vírgula).
#
# /auth e /users são sempre reais, independentemente desta lista.
#
# `/timekeeping` saiu de propósito. O backend serve apenas
# `/timekeeping/mirror`; `/timekeeping/pending` e `/timekeeping/adjustments`,
# que o /inicio consome, ainda não existem. Com o prefixo ligado, os blocos do
# Início respondiam 404 — devolver o prefixo é tarefa de quem criar os dois
# endpoints, junto de /pendencias e /ajustes.
#
# Ainda no mock: /badges, /audit-logs, /gate, /settings.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_REAL_API_PREFIXES="/access-events,/devices,/departments,/employees,/schedules,/absences"
